rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function myRole() {
      return myUser() != null ? myUser().role : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isStaff() {
      return myRole() == 'admin' || myRole() == 'inspector';
    }

    match /publicLoginUsers/{userId} {
      // Acceso público de lectura para poder validar credenciales de PIN
      // antes de autenticar (login por PIN). Solo admin puede escribir.
      allow read: if true;
      allow write: if signedIn() && isAdmin();
    }

    match /pinLogins/{pinId} {
      allow read: if signedIn();
      allow write: if signedIn() && isAdmin();
    }

    match /profiles/{userId} {
      // Perfiles de la app "nueva" (GitHub Pages / registro por email).
      // Lectura pública para poder resolver el email a partir del nombre
      // antes de autenticar; escritura solo sobre el propio perfil.
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && isAdmin();
      allow update: if signedIn() && (
        isAdmin() ||
        (
          isStaff() &&
          userId != request.auth.uid &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['points'])
        )
      );
      allow delete: if signedIn() && isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn() && isStaff();
      allow write: if signedIn() && isAdmin();
    }

    match /logs/{logId} {
      allow read: if signedIn() && isStaff();
      allow create: if signedIn() && isStaff();
      allow update, delete: if signedIn() && isAdmin();
    }

    match /novedades/{id} {
      allow read: if true;
      allow create: if signedIn() && isStaff();
      allow update, delete: if signedIn() && isAdmin();
    }
  }
}